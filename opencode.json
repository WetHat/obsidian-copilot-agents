{
  "$schema": "https://opencode.ai/config.json",
  "skills": ["~/OneDrive/Documents/ObsidianVaults/WetHat Lab/copilot/skills"],
  "mcp": {
    "servers": {
    "firecrawl": {
      "type": "local",
      "command": ["npx", "-y", "firecrawl-mcp"],
      "disabled": false,
      "timeout": {
        "catalog": 60000,
        "execution": 120000
      }
    },
    "docker-mcp": {
      "type": "local",
      "command": ["docker", "mcp", "gateway", "run", "--profile", "obsidian"],
      "disabled": false,
      "timeout": {
        "catalog": 60000,
        "execution": 60000
      }
    },
    "windmill": {
      "type": "remote",
      "url": "http://localhost/api/mcp/w/obsidian/mcp",
      "disabled": false,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:WINDMILL_MCP_TOKEN}"
      }
    }
    }
  }
}
